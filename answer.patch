 # and toolsets. If you change any versions, please update README.md.
 
 jobs:
+  unified_compilers:
+    strategy:
+      matrix:
+        include:
+          # GCC
+          - { compiler: gcc, version: 12, cc: gcc-12, cxx: g++-12, os: ubuntu-latest }
+          - { compiler: gcc, version: 13, cc: gcc-13, cxx: g++-13, os: ubuntu-latest }
+          - { compiler: gcc, version: 14, cc: gcc-14, cxx: g++-14, os: ubuntu-latest }
+          # Clang
+          - { compiler: clang, version: 16, cc: clang-16, cxx: clang++-16, os: ubuntu-latest }
+          - { compiler: clang, version: 17, cc: clang-17, cxx: clang++-17, os: ubuntu-latest }
+          - { compiler: clang, version: 18, cc: clang-18, cxx: clang++-18, os: ubuntu-latest }
+          # XCode
+          - { compiler: xcode, version: '14.3.1', cc: clang, cxx: clang++, os: macos-13 }
+          - { compiler: xcode, version: '15.4', cc: clang, cxx: clang++, os: macos-14 }
