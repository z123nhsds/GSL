#ifndef GSL_ASSERT_H
#define GSL_ASSERT_H

//
// Temporary until MSVC STL supports no-exceptions mode.
// Currently terminate is a no-op in this mode, so we add termination behavior back
//
#if defined(_MSC_VER) && (defined(_KERNEL_MODE) || (defined(_HAS_EXCEPTIONS) && !_HAS_EXCEPTIONS))
#define GSL_KERNEL_MODE

#define GSL_MSVC_USE_STL_NOEXCEPTION_WORKAROUND
#include <intrin.h>
#define RANGE_CHECKS_FAILURE 0

#if defined(__clang__)
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Winvalid-noreturn"
#endif // defined(__clang__)

#else // defined(_MSC_VER) && (defined(_KERNEL_MODE) || (defined(_HAS_EXCEPTIONS) &&
      // !_HAS_EXCEPTIONS))

#include <exception>

#endif // defined(_MSC_VER) && (defined(_KERNEL_MODE) || (defined(_HAS_EXCEPTIONS) &&
       // !_HAS_EXCEPTIONS))

//
// make suppress attributes parse for some compilers
// Hopefully temporary until suppression standardization occurs
//

// Detect if compiler supports gsl::suppress attribute
#if defined(__has_cpp_attribute)
#if __has_cpp_attribute(gsl::suppress)
#define GSL_HAS_SUPPRESS_ATTRIBUTE 1
#endif
#endif

#ifndef GSL_HAS_SUPPRESS_ATTRIBUTE
#define GSL_HAS_SUPPRESS_ATTRIBUTE 0
#endif

// Detect if compiler supports quoted suppress format: [[gsl::suppress("tag")]]
// MSVC 1950+ (VS 2022 17.4+) and Clang support the quoted format correctly
// Older MSVC versions only understand unquoted format: [[gsl::suppress(tag)]]
#if defined(__clang__)
#define GSL_SUPPRESS_USE_QUOTES 1
#elif defined(_MSC_VER) && _MSC_VER >= 1950
#define GSL_SUPPRESS_USE_QUOTES 1
#else
#define GSL_SUPPRESS_USE_QUOTES 0
#endif

// Internal implementation macro
#if GSL_SUPPRESS_USE_QUOTES
#define GSL_SUPPRESS_IMPL(x) [[gsl::suppress(#x)]]
#elif GSL_HAS_SUPPRESS_ATTRIBUTE
#define GSL_SUPPRESS_IMPL(x) [[gsl::suppress(x)]]
#else
#define GSL_SUPPRESS_IMPL(x)
#endif

// Main macro - supports both GSL_SUPPRESS(tag) and GSL_SUPPRESS("tag")
// When called as GSL_SUPPRESS(bounds.1), #x stringifies to "bounds.1"
// When called as GSL_SUPPRESS("bounds.1"), passes through as-is for compilers that support it
#if GSL_HAS_SUPPRESS_ATTRIBUTE
#define GSL_SUPPRESS(...) GSL_SUPPRESS_IMPL(__VA_ARGS__)
#else
#define GSL_SUPPRESS(...)
#endif

// Strict mode: warn on unused suppressions
#if defined(GSL_SUPPRESS_STRICT_MODE) && GSL_SUPPRESS_STRICT_MODE
#if defined(__clang__)
#define GSL_SUPPRESS_STRICT_ANNOTATION [[gsl::suppress(__VA_ARGS__), clang::warn_unused]]
#elif defined(__GNUC__) && __GNUC__ >= 5
#define GSL_SUPPRESS_STRICT_ANNOTATION [[gsl::suppress(__VA_ARGS__)]] __attribute__((unused))
#else
#define GSL_SUPPRESS_STRICT_ANNOTATION GSL_SUPPRESS(__VA_ARGS__)
#endif
#endif

#if defined(__clang__) || defined(__GNUC__)
#define GSL_LIKELY(x) __builtin_expect(!!(x), 1)
#define GSL_UNLIKELY(x) __builtin_expect(!!(x), 0)

#else

#define GSL_LIKELY(x) (!!(x))
#define GSL_UNLIKELY(x) (!!(x))
#endif // defined(__clang__) || defined(__GNUC__)

//
// GSL_ASSUME(cond)
//
// Tell the optimizer that the predicate cond must hold. It is unspecified
// whether or not cond is actually evaluated.
//
#ifdef _MSC_VER
#define GSL_ASSUME(cond) __assume(cond)
#elif defined(__GNUC__)
#define GSL_ASSUME(cond) ((cond) ? static_cast<void>(0) : __builtin_unreachable())
#else
#define GSL_ASSUME(cond) static_cast<void>((cond) ? 0 : 0)
#endif

//
// GSL.assert: assertions
//

namespace gsl
{

namespace details
{
#if defined(GSL_MSVC_USE_STL_NOEXCEPTION_WORKAROUND)

    typedef void(__cdecl* terminate_handler)();

    // clang-format off
    GSL_SUPPRESS(f.6) // NO-FORMAT: attribute
    // clang-format on
    [[noreturn]] inline void __cdecl default_terminate_handler()
    {
        __fastfail(RANGE_CHECKS_FAILURE);
    }

    inline gsl::details::terminate_handler& get_terminate_handler() noexcept
    {
        static terminate_handler handler = &default_terminate_handler;
        return handler;
    }

#endif // defined(GSL_MSVC_USE_STL_NOEXCEPTION_WORKAROUND)

    [[noreturn]] inline void terminate() noexcept
    {
#if defined(GSL_MSVC_USE_STL_NOEXCEPTION_WORKAROUND)
        (*gsl::details::get_terminate_handler())();
#else
        std::terminate();
#endif // defined(GSL_MSVC_USE_STL_NOEXCEPTION_WORKAROUND)
    }

} // namespace details
} // namespace gsl

#define GSL_CONTRACT_CHECK(type, cond)                                                             \
    (GSL_LIKELY(cond) ? static_cast<void>(0) : gsl::details::terminate())

#define Expects(cond) GSL_CONTRACT_CHECK("Precondition", cond)
#define Ensures(cond) GSL_CONTRACT_CHECK("Postcondition", cond)

#if defined(GSL_MSVC_USE_STL_NOEXCEPTION_WORKAROUND) && defined(__clang__)
#pragma clang diagnostic pop
#endif

#endif // GSL_ASSERT_H
