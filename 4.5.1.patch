+#include <gtest/gtest.h>
+#include <gsl/assert>
+#include <gsl/span>
+
+// Test case for GSL_SUPPRESS(26481) - suppresses C++ Core Guidelines warning
+// about using span instead of pointer arithmetic
+
+TEST(gsl_suppress_test, test_gsl_suppress_26481)
+{
+    int arr[5] = {1, 2, 3, 4, 5};
+    int* p = arr;
+
+    // Use GSL_SUPPRESS(26481) to suppress warning about pointer arithmetic
+    // Warning 26481: "Don't use pointer arithmetic. Use span instead."
+    GSL_SUPPRESS(26481)
+    int val = *(p + 2); // This would normally trigger warning 26481
+
+    EXPECT_EQ(val, 3);
+
+    // Also test with gsl::span to verify it works alongside
+    gsl::span<int> s = arr;
+    EXPECT_EQ(s[2], 3);
+}
+
+// Test case to verify other GSL_SUPPRESS uses work correctly
+TEST(gsl_suppress_test, test_gsl_suppress_other)
+{
+    // Test GSL_SUPPRESS with string warning codes
+    GSL_SUPPRESS(bounds.1)
+    int arr[5] = {1, 2, 3, 4, 5};
+    
+    // Use GSL_SUPPRESS(type.1) for type-related warnings
+    GSL_SUPPRESS(type.1)
+    char c = static_cast<char>(arr[0]);
+
+    EXPECT_EQ(c, 1);
+}
