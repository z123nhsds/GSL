+
+// Minimal test case to demonstrate the stringification bug in GSL_SUPPRESS macro
+//
+// BUGGY VERSION (will fail to compile on GCC/Clang):
+//   #define GSL_SUPPRESS(x) [[gsl::suppress(x)]]
+//
+// When calling GSL_SUPPRESS(f.6), it expands to:
+//   [[gsl::suppress(f.6)]]
+//
+// The problem: f.6 is not a string literal. GCC/Clang cannot parse this
+// as a valid attribute argument, causing compilation errors.
+//
+// FIXED VERSION:
+//   #define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
+//
+// Now GSL_SUPPRESS(f.6) expands to:
+//   [[gsl::suppress("f.6")]]
+//
+// The # operator converts the macro argument to a string literal,
+// which is valid attribute syntax for all compilers.
+
+#include "gsl/assert"
+
+// Test cases that would fail with the buggy macro definition
+// These all use dot-notation rule tags like f.6, type.1, bounds.1
+
+GSL_SUPPRESS(f.6)
+void test_suppress_f6() { }
+
+GSL_SUPPRESS(type.1)
+void test_suppress_type1() { }
+
+GSL_SUPPRESS(bounds.1)
+void test_suppress_bounds1() { }
+
+GSL_SUPPRESS(es.46)
+void test_suppress_es46() { }
+
+int main()
+{
+    test_suppress_f6();
+    test_suppress_type1();
+    test_suppress_bounds1();
+    test_suppress_es46();
+    return 0;
+}
