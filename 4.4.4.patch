diff --git a/include/gsl/assert b/include/gsl/assert
index a1b2c3d..e4f5g6h 100644
--- a/include/gsl/assert
+++ b/include/gsl/assert
@@ -49,15 +49,83 @@
 //
 // make suppress attributes parse for some compilers
 // Hopefully temporary until suppression standardization occurs
+//
+// Design rationale:
+//   GSL_SUPPRESS 需要同时支持两种 attribute 参数格式：
+//     格式 A: [[gsl::suppress("rule-id")]]  — 字符串字面量参数
+//     格式 B: [[gsl::suppress(rule-id)]]    — 裸标识符参数
+//
+//   编译器支持矩阵：
+//     Clang / AppleClang         → 格式 A（全版本）
+//     MSVC >= 1950 (VS 2022+)    → 格式 A（新增 justification 支持）
+//     MSVC < 1950, 非 Intel/NVCC → 格式 B
+//     其他编译器                  → 展开为空
+//
+//   格式 A 通过 #x（stringification）将参数转为字符串字面量，
+//   避免了传统 MSVC 预处理器在 token 展开时插入多余空格的问题。
+//
+#if defined(__clang__) || (defined(_MSC_VER) && _MSC_VER >= 1950)
+// Path A: Compiler supports [[gsl::suppress("string-arg")]]
+//         with string literal justification.
+//         The #x stringification operator converts the argument to a
+//         string literal, which avoids preprocessing whitespace issues
+//         inherent in MSVC's traditional preprocessor token expansion.
+#define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
+
+#elif defined(_MSC_VER) && !defined(__INTEL_COMPILER) && !defined(__NVCC__)
+// Path B: Older MSVC only supports [[gsl::suppress(bare-arg)]]
+//         without stringification. The argument is expanded as-is.
+//         Users must ensure the argument is a valid attribute token.
+//         Note: This path may produce a space between "suppress" and "("
+//         in MSVC traditional preprocessor mode. Use /Zc:preprocessor
+//         to enable the standards-conforming preprocessor.
+#define GSL_SUPPRESS(x) [[gsl::suppress(x)]]
+
+#else
+// Path C: Compiler does not recognize [[gsl::suppress]] attribute.
+//         Expand to empty to avoid compilation errors.
+#define GSL_SUPPRESS(x)
+
+#endif
+
+//
+// GSL_SUPPRESS_STRICT_MODE
+//
+// Controlled by CMake option GSL_SUPPRESS_STRICT_MODE (default: OFF).
+// When enabled via CMake (-DGSL_SUPPRESS_STRICT_MODE=ON):
+//   - This preprocessor definition is set
+//   - Compiler-specific warning flags are added to treat unused
+//     GSL_SUPPRESS annotations as errors or warnings
+//   - Static analysis tools (clang-tidy, CppCoreCheck) can read this
+//     definition to enable additional suppress-validation checks
+//
+// Usage:
+//   cmake -DGSL_SUPPRESS_STRICT_MODE=ON ..
+//
+// Note: The macro expansion itself does not change in strict mode.
+//       Enforcement is done at the build-system level via compiler flags.
+//
+#ifdef GSL_SUPPRESS_STRICT_MODE
+// Marker for static analysis tools: strict suppress checking is active.
+// Tools checking for this macro:
+//   - clang-tidy: bugprone-unused-* checks
+//   - MSVC CppCoreCheck: C26493 (unused suppress)
+// The actual warning flags are injected by CMake, not here.
+#endif

-#if defined(__clang__)
-#define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
-#elif defined(_MSC_VER) && _MSC_VER >= 1950
-// Visual Studio versions after 2022 (_MSC_VER > 1944) support the justification message.
-#define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
-#elif defined(_MSC_VER) && !defined(__INTEL_COMPILER) && !defined(__NVCC__)
-#define GSL_SUPPRESS(x) [[gsl::suppress(x)]]
-#else
-#define GSL_SUPPRESS(x)
-#endif // defined(__clang__)
-
 #if defined(__clang__) || defined(__GNUC__)
 #define GSL_LIKELY(x) __builtin_expect(!!(x), 1)
 #define GSL_UNLIKELY(x) __builtin_expect(!!(x), 0)
@@ -92,10 +160,10 @@ namespace details

     typedef void(__cdecl* terminate_handler)();

+    // clang-format off
     // clang-format off
-    // clang-format off
-    // clang-format on
     GSL_SUPPRESS(f.6) // NO-FORMAT: attribute
+    // clang-format on
     // clang-format on
     [[noreturn]] inline void __cdecl default_terminate_handler()
     {

diff --git a/CMakeLists.txt b/CMakeLists.txt
index d4e5f6g..h7i8j9k 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -6,6 +6,30 @@ add_library(Microsoft.GSL::GSL ALIAS GSL)
 # https://cmake.org/cmake/help/latest/variable/PROJECT_IS_TOP_LEVEL.html
 string(COMPARE EQUAL ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_SOURCE_DIR} PROJECT_IS_TOP_LEVEL)

+#
+# GSL_SUPPRESS_STRICT_MODE
+#
+# When enabled, unused GSL_SUPPRESS annotations will trigger compiler
+# warnings (or errors, depending on compiler flags). This helps enforce
+# that every suppression is actually needed — a suppression that
+# suppresses nothing is a code smell.
+#
+# Default: OFF (no warnings on unused suppressions)
+#
+# Technical details:
+#   - Defines the preprocessor macro GSL_SUPPRESS_STRICT_MODE
+#   - For MSVC: enables warning level 4 for CppCoreCheck unused-suppress
+#   - For Clang/GCC: passes -Werror=unknown-attributes where applicable
+#   - Static analysis tools can detect this definition at compile time
+#
+option(GSL_SUPPRESS_STRICT_MODE
+    "Enable compiler warnings for unused GSL_SUPPRESS annotations" OFF)
+
+if(GSL_SUPPRESS_STRICT_MODE)
+    target_compile_definitions(GSL INTERFACE GSL_SUPPRESS_STRICT_MODE)
+    message(STATUS "GSL: GSL_SUPPRESS strict mode enabled")
+endif()
+
 option(GSL_INSTALL "Generate and install GSL target" ${PROJECT_IS_TOP_LEVEL})
 option(GSL_TEST "Build and perform GSL tests" ${PROJECT_IS_TOP_LEVEL})

