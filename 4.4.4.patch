+///////////////////////////////////////////////////////////////////////////////
+
+#include <gsl/assert>
+#include <gtest/gtest.h>
+
+#include <type_traits>
+
+using namespace gsl;
+
+// ===========================================================================
+// Test 1: GSL_SUPPRESS 基本编译测试（烟雾测试）
+// ===========================================================================
+// 目的：验证 GSL_SUPPRESS 宏在所有支持的编译器下都能够成功编译。
+//       这是最基本的回归测试，确保宏展开后是合法的 C++14 语法。
+
+namespace
+{
+// 模拟一些会触发编译器/分析器警告的代码模式
+// GSL_SUPPRESS 标注在这些代码上，验证编译通过
+
+GSL_SUPPRESS(bounds.1) // suppress bounds warning on raw pointer arithmetic
+int unsafe_pointer_arithmetic(int* p, int index)
+{
+    return *(p + index);
+}
+
+GSL_SUPPRESS(type.1) // suppress type warning on C-style cast
+void* unsafe_c_cast(int* p)
+{
+    return (void*)p;
+}
+
+GSL_SUPPRESS(con.1) // suppress const-correctness warning
+void unsafe_const_discard(const int* p)
+{
+    int* q = const_cast<int*>(p);
+    (void)q;
+}
+
+GSL_SUPPRESS(f.6) // suppress free/delete mismatch or raw new usage
+int* raw_new_allocation()
+{
+    return new int(42);
+}
+} // namespace
+
+TEST(suppress_tests, basic_compilation)
+{
+    int arr[10] = {};
+    EXPECT_EQ(unsafe_pointer_arithmetic(arr, 3), 0);
+
+    int x = 42;
+    void* vp = unsafe_c_cast(&x);
+    EXPECT_NE(vp, nullptr);
+
+    const int cx = 42;
+    unsafe_const_discard(&cx);
+
+    int* p = raw_new_allocation();
+    ASSERT_NE(p, nullptr);
+    EXPECT_EQ(*p, 42);
+    delete p;
+}
+
+// ===========================================================================
+// Test 2: GSL_SUPPRESS 在类/结构体成员上的使用
+// ===========================================================================
+// 目的：验证 GSL_SUPPRESS 可以用在类成员函数、成员变量上。
+//       属性语法 [[gsl::suppress(...)]] 在类上下文中的兼容性。
+
+namespace
+{
+class suppress_on_members
+{
+public:
+    GSL_SUPPRESS(bounds.2) // suppress bounds warning on pointer member access
+    int get_value(const int* arr, size_t index) const
+    {
+        return arr[index];
+    }
+
+    GSL_SUPPRESS(con.4) // suppress const-correctness on mutable member
+    void mutate() const
+    {
+        counter_++;
+    }
+
+    int counter() const { return counter_; }
+
+private:
+    GSL_SUPPRESS(con.4)
+    mutable int counter_ = 0;
+};
+} // namespace
+
+TEST(suppress_tests, on_class_members)
+{
+    suppress_on_members obj;
+    int arr[5] = {1, 2, 3, 4, 5};
+
+    EXPECT_EQ(obj.get_value(arr, 2), 3);
+
+    EXPECT_EQ(obj.counter(), 0);
+    obj.mutate();
+    EXPECT_EQ(obj.counter(), 1);
+}
+
+// ===========================================================================
+// Test 3: GSL_SUPPRESS 在模板代码中的使用
+// ===========================================================================
+// 目的：验证 GSL_SUPPRESS 在模板实例化上下文中正常工作。
+//       模板代码中属性不会被 SFINAE 影响。
+
+namespace
+{
+template <typename T>
+GSL_SUPPRESS(type.1) // suppress type warning on reinterpret_cast in template
+T* raw_pointer_from_uintptr(uintptr_t addr)
+{
+    return reinterpret_cast<T*>(addr);
+}
+
+template <typename T, size_t N>
+GSL_SUPPRESS(bounds.1)
+T* array_end(T (&arr)[N])
+{
+    return arr + N;
+}
+} // namespace
+
+TEST(suppress_tests, in_template_code)
+{
+    uintptr_t addr = 0x1000;
+    int* p = raw_pointer_from_uintptr<int>(addr);
+    EXPECT_NE(p, nullptr);
+
+    int arr[3] = {10, 20, 30};
+    int* end = array_end(arr);
+    EXPECT_EQ(end, arr + 3);
+}
+
+// ===========================================================================
+// Test 4: 多个 GSL_SUPPRESS 连续使用
+// ===========================================================================
+// 目的：验证同一个声明上可以放置多个 GSL_SUPPRESS 宏。
+//       这在需要同时抑制多条规则时很常见。
+
+namespace
+{
+GSL_SUPPRESS(bounds.1)
+GSL_SUPPRESS(type.1)
+GSL_SUPPRESS(con.1)
+int multi_suppress_example(int* p, size_t idx)
+{
+    return *reinterpret_cast<int*>(reinterpret_cast<char*>(p) + idx);
+}
+} // namespace
+
+TEST(suppress_tests, multiple_suppress_on_same_declaration)
+{
+    int x = 42;
+    EXPECT_EQ(multi_suppress_example(&x, 0), 42);
+}
+
+// ===========================================================================
+// Test 5: GSL_SUPPRESS 在 lambda 表达式上的使用
+// ===========================================================================
+// 目的：验证 GSL_SUPPRESS 在 lambda 上的兼容性。
+//       C++14 泛型 lambda 可能触发各种诊断规则。
+
+TEST(suppress_tests, on_lambda)
+{
+    GSL_SUPPRESS(bounds.1)
+    auto unsafe_lambda = [](int* p, int idx) -> int {
+        return p[idx];
+    };
+
+    int arr[5] = {1, 2, 3, 4, 5};
+    EXPECT_EQ(unsafe_lambda(arr, 2), 3);
+}
+
+// ===========================================================================
+// Test 6: GSL_SUPPRESS 在命名空间级别使用
+// ===========================================================================
+// 目的：验证在命名空间级别、全局函数上使用 GSL_SUPPRESS。
+
+namespace suppress_test_ns
+{
+GSL_SUPPRESS(bounds.1)
+int global_unsafe_access(int* p, int i)
+{
+    return p[i];
+}
+} // namespace suppress_test_ns
+
+TEST(suppress_tests, at_namespace_scope)
+{
+    int arr[3] = {100, 200, 300};
+    EXPECT_EQ(suppress_test_ns::global_unsafe_access(arr, 1), 200);
+}
+
+// ===========================================================================
+// Test 7: 编译期验证 — GSL_SUPPRESS 展开后不影响类型系统
+// ===========================================================================
+// 目的：使用 static_assert 验证 GSL_SUPPRESS 标注的函数仍然
+//       保持正常的类型特征（返回类型、noexcept 等）。
+
+namespace
+{
+GSL_SUPPRESS(bounds.1)
+int suppressed_function(int* p, int i) noexcept
+{
+    return p[i];
+}
+} // namespace
+
+TEST(suppress_tests, preserves_type_system)
+{
+    static_assert(
+        std::is_same<decltype(suppressed_function), int(int*, int)>::value,
+        "GSL_SUPPRESS must not change the function type");
+
+    static_assert(
+        noexcept(suppressed_function(nullptr, 0)),
+        "GSL_SUPPRESS must preserve noexcept specification");
+
+    int arr[2] = {7, 8};
+    EXPECT_EQ(suppressed_function(arr, 0), 7);
+}
+
+// ===========================================================================
+// Test 8: 严格模式条件编译验证
+// ===========================================================================
+// 目的：验证 GSL_SUPPRESS_STRICT_MODE 宏在 CMake 选项 OFF 时未被定义，
+//       在 ON 时被正确定义。此测试在两种模式下均应通过。
+
+TEST(suppress_tests, strict_mode_compile_check)
+{
+#ifdef GSL_SUPPRESS_STRICT_MODE
+    SUCCEED() << "GSL_SUPPRESS_STRICT_MODE is enabled: unused suppressions "
+                 "will trigger compiler warnings";
+#else
+    SUCCEED() << "GSL_SUPPRESS_STRICT_MODE is disabled (default)";
+#endif
+}

===================================================================
第四部分：CMake 严格模式编译器标志补充（推荐配置）
===================================================================

以下为 CMakeLists.txt 中 GSL_SUPPRESS_STRICT_MODE 区块的扩展版本，
包含编译器特定的警告标志：

    option(GSL_SUPPRESS_STRICT_MODE
        "Enable compiler warnings for unused GSL_SUPPRESS annotations" OFF)

    if(GSL_SUPPRESS_STRICT_MODE)
        target_compile_definitions(GSL INTERFACE GSL_SUPPRESS_STRICT_MODE)

        # MSVC: CppCoreCheck 会检查 unused suppress，将其提升为警告
        if(MSVC)
            # C26493: 未使用的 gsl::suppress — 启用为 level-4 警告
            target_compile_options(GSL INTERFACE
                /w14993
            )
        endif()

        # Clang: 启用 clang-tidy 相关的 suppress 检查
        # 这些通常通过 .clang-tidy 配置文件控制，在此处记录
        #   - bugprone-unused-return-value
        #   - misc-unused-parameters (suppress 可能隐藏未使用参数)

        message(STATUS "GSL: GSL_SUPPRESS strict mode enabled — "
                        "unused suppressions will produce warnings")
    endif()

