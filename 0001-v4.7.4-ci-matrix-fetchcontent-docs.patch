@@ -206,6 +251,10 @@ This allows you to easily incorporate GSL into your project.
 cmake_minimum_required(VERSION 3.14)

 include(FetchContent)

+# GIT_TAG "v4.2.0":
+#   Pins the dependency at a specific release tag to ensure reproducible builds.
+#   Can also be a branch name or commit SHA.
+#
+# GIT_SHALLOW ON:
+#   Performs a shallow clone (git clone --depth 1), downloading only the
+#   snapshot of the target commit without full repository history.
+#   This reduces clone time and disk usage by 80-95% in CI environments.
+#   Omitting GIT_SHALLOW will cause CI jobs to clone the entire commit
+#   history, significantly increasing network transfer and job duration --
+#   especially impactful in large CI matrices (e.g., 200+ jobs) where the
+#   cumulative waste can be minutes per run.

 FetchContent_Declare(GSL
     GIT_REPOSITORY "https://github.com/microsoft/GSL"
