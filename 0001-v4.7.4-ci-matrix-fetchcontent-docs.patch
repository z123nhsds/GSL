+            cc: clang-16
+            cxx: clang++-16
+            cmake_preset_prefix: clang
+
+          - name: Clang 17
+            os: ubuntu-latest
+            cc: clang-17
+            cxx: clang++-17
+            cmake_preset_prefix: clang
+            exclude_cxx23: true
+
+          - name: Clang 18
+            os: ubuntu-latest
+            cc: clang-18
+            cxx: clang++-18
+            cmake_preset_prefix: clang
+
+          # ================================================================
+          #  XCode / Apple Clang: 14.3.1, 15.4 on macos
+          # ================================================================
+          - name: XCode 14.3.1
