-From: GSL CI Matrix Enhancement
-Subject: [PATCH] Add unified CI matrix with include blocks, FetchContent docs, and CTest span filter
-
----
-Question 1: CI Matrix include block with CC/CXX for all compilers
----
-
-The following `include` block defines a unified matrix strategy that covers
-GCC 12/13/14, Clang 16/17/18, XCode 14.3.1/15.4, and VS2019/VS2022 (MSVC + LLVM),
-each with the appropriate CC/CXX environment variables:
-
---- a/.github/workflows/compilers.yml
-+++ b/.github/workflows/compilers.yml
-@@ -0,0 +1,120 @@
-+name: Compiler Integration Tests (Unified Matrix)
-+
-+concurrency:
-+  group: ${{ github.workflow }}-${{ github.event.pull_request.number || github.ref }}
-+  cancel-in-progress: true
-+
-+on:
-+  push:
-+    branches: [ main ]
-+  pull_request:
-+    branches: [ main ]
-+
-+jobs:
-+  compiler-matrix:
-+    strategy:
-+      fail-fast: false
-+      matrix:
-+        include:
-+          # ── GCC 12/13/14 on Ubuntu ──────────────────────────────────
-+          - compiler_family: gcc
-+            compiler_version: 12
-+            os: ubuntu-latest
-+            cc: gcc-12
-+            cxx: g++-12
-+            cmake_preset_prefix: gcc
-+          - compiler_family: gcc
-+            compiler_version: 13
-+            os: ubuntu-latest
-+            cc: gcc-13
-+            cxx: g++-13
-+            cmake_preset_prefix: gcc
-+          - compiler_family: gcc
-+            compiler_version: 14
-+            os: ubuntu-latest
-+            cc: gcc-14
-+            cxx: g++-14
-+            cmake_preset_prefix: gcc
-+
-+          # ── Clang 16/17/18 on Ubuntu ────────────────────────────────
-+          - compiler_family: clang
-+            compiler_version: 16
-+            os: ubuntu-latest
-+            cc: clang-16
-+            cxx: clang++-16
-+            cmake_preset_prefix: clang
-+          - compiler_family: clang
-+            compiler_version: 17
-+            os: ubuntu-latest
-+            cc: clang-17
-+            cxx: clang++-17
-+            cmake_preset_prefix: clang
-+          - compiler_family: clang
-+            compiler_version: 18
-+            os: ubuntu-latest
-+            cc: clang-18
-+            cxx: clang++-18
-+            cmake_preset_prefix: clang
-+
-+          # ── XCode 14.3.1 / 15.4 on macOS (Apple Clang) ─────────────
-+          - compiler_family: xcode
-+            compiler_version: "14.3.1"
-+            os: macos-13
-+            cc: cc
-+            cxx: c++
-+            cmake_preset_prefix: clang
-+          - compiler_family: xcode
-+            compiler_version: "15.4"
-+            os: macos-14
-+            cc: cc
-+            cxx: c++
-+            cmake_preset_prefix: clang
-+
-+          # ── Visual Studio 2019 – MSVC ───────────────────────────────
-+          - compiler_family: msvc
-+            compiler_version: 2019
-+            os: windows-2019
-+            cc: cl
-+            cxx: cl
-+            cmake_preset_prefix: msvc
-+            generator: "Visual Studio 16 2019"
-+            toolset: ""
-+
-+          # ── Visual Studio 2019 – LLVM (ClangCL) ─────────────────────
-+          - compiler_family: llvm
-+            compiler_version: 2019
-+            os: windows-2019
-+            cc: clang-cl
-+            cxx: clang-cl
-+            cmake_preset_prefix: msvc
-+            generator: "Visual Studio 16 2019"
-+            toolset: "-T ClangCL"
-+
-+          # ── Visual Studio 2022 – MSVC ───────────────────────────────
-+          - compiler_family: msvc
-+            compiler_version: 2022
-+            os: windows-2022
-+            cc: cl
-+            cxx: cl
-+            cmake_preset_prefix: msvc
-+            generator: "Visual Studio 17 2022"
-+            toolset: ""
-+
-+          # ── Visual Studio 2022 – LLVM (ClangCL) ─────────────────────
-+          - compiler_family: llvm
-+            compiler_version: 2022
-+            os: windows-2022
-+            cc: clang-cl
-+            cxx: clang-cl
-+            cmake_preset_prefix: msvc
-+            generator: "Visual Studio 17 2022"
-+            toolset: "-T ClangCL"
-+
-+        build_type: [ Debug, Release ]
-+        cxx_version: [ 14, 17, 20, 23 ]
-+
-+        exclude:
-+          # gcc-12 cannot compile GoogleTest with C++20/23
-+          - compiler_family: gcc
-+            compiler_version: 12
-+            cxx_version: 20
-+          - compiler_family: gcc
-+            compiler_version: 12
-+            cxx_version: 23
-+          # clang-17 has a known issue with C++23
-+          - compiler_family: clang
-+            compiler_version: 17
-+            cxx_version: 23
-+
-+    runs-on: ${{ matrix.os }}
-+    steps:
-+      - uses: actions/checkout@v6
-+
-+      - name: Select XCode version (macOS)
-+        if: matrix.compiler_family == 'xcode'
-+        run: sudo xcode-select -s /Applications/Xcode_${{ matrix.compiler_version }}.app
-+
-+      - name: Configure & Build
-+        uses: ./.github/workflows/cmake
-+        with:
-+          cmake_preset: ${{ matrix.cmake_preset_prefix }}-${{ matrix.cxx_version }}-${{ matrix.build_type == 'Debug' && 'debug' || 'release' }}
-+          extra_cmake_configure_args: ${{ matrix.toolset || '' }}
-+        env:
-+          CC: ${{ matrix.cc }}
-+          CXX: ${{ matrix.cxx }}
