diff --git a/CMakeLists.txt b/CMakeLists.txt
index b306dc1..9db7d46 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,7 @@ string(COMPARE EQUAL ${CMAKE_CURRENT_SOURCE_DIR} ${CMAKE_SOURCE_DIR} PROJECT_IS_
 
 option(GSL_INSTALL "Generate and install GSL target" ${PROJECT_IS_TOP_LEVEL})
 option(GSL_TEST "Build and perform GSL tests" ${PROJECT_IS_TOP_LEVEL})
+option(GSL_SUPPRESS_STRICT_MODE "Enable strict mode for GSL_SUPPRESS to warn about unused suppressions" OFF)
 
 # The implementation generally assumes a platform that implements C++14 support
 target_compile_features(GSL INTERFACE "cxx_std_14")
diff --git a/include/CMakeLists.txt b/include/CMakeLists.txt
index fe4eed9..df1fd77 100644
--- a/include/CMakeLists.txt
+++ b/include/CMakeLists.txt
@@ -11,3 +11,8 @@ if(PROJECT_IS_TOP_LEVEL)
 else()
     target_include_directories(GSL SYSTEM INTERFACE $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}>)
 endif()
+
+# GSL_SUPPRESS_STRICT_MODE option
+if(GSL_SUPPRESS_STRICT_MODE)
+    target_compile_definitions(GSL INTERFACE GSL_SUPPRESS_STRICT_MODE)
+endif()
diff --git a/include/gsl/assert b/include/gsl/assert
index a08424c..714875e 100644
--- a/include/gsl/assert
+++ b/include/gsl/assert
@@ -45,17 +45,28 @@
 // make suppress attributes parse for some compilers
 // Hopefully temporary until suppression standardization occurs
 //
+
+// Helper macros for stringification
+#define GSL_SUPPRESS_STRINGIFY_INTERNAL(x) #x
+#define GSL_SUPPRESS_STRINGIFY(x) GSL_SUPPRESS_STRINGIFY_INTERNAL(x)
+
+// Determine the correct suppress format based on compiler
 #if defined(__clang__)
-#define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
+// Clang prefers quoted form
+#define GSL_SUPPRESS(x) [[gsl::suppress(GSL_SUPPRESS_STRINGIFY(x))]]
 #elif defined(_MSC_VER) && _MSC_VER >= 1950
-// Visual Studio versions after 2022 (_MSC_VER > 1944) support the justification message.
-#define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
+// Visual Studio 2022+ supports quoted form
+#define GSL_SUPPRESS(x) [[gsl::suppress(GSL_SUPPRESS_STRINGIFY(x))]]
 #elif defined(_MSC_VER) && !defined(__INTEL_COMPILER) && !defined(__NVCC__)
+// Older MSVC prefers identifier form
 #define GSL_SUPPRESS(x) [[gsl::suppress(x)]]
 #else
 #define GSL_SUPPRESS(x)
 #endif // defined(__clang__)
 
+// Explicit form that accepts string literals directly
+#define GSL_SUPPRESS_STR(x) [[gsl::suppress(x)]]
+
 #if defined(__clang__) || defined(__GNUC__)
 #define GSL_LIKELY(x) __builtin_expect(!!(x), 1)
 #define GSL_UNLIKELY(x) __builtin_expect(!!(x), 0)
