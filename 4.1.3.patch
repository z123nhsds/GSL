+// 实现 RAII 版本 gsl::finally，捕获异常时仍执行清理动作
+template <class F>
+[[nodiscard]] auto finally(F&& f) noexcept
+{
+    return final_action<std::decay_t<F>>{std::forward<F>(f)};
+}
