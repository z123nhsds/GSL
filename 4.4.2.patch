@@ -41,27 +41,34 @@
 #endif // defined(_MSC_VER) && (defined(_KERNEL_MODE) || (defined(_HAS_EXCEPTIONS) &&
        // !_HAS_EXCEPTIONS))
 
-//
-// make suppress attributes parse for some compilers
-// Hopefully temporary until suppression standardization occurs
-//
+#ifndef GSL_SUPPRESS_STRICT_MODE
+#define GSL_SUPPRESS_STRICT_MODE 0
+#endif
+
 #if defined(__clang__)
-#define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
-#elif defined(_MSC_VER) && _MSC_VER >= 1950
-// Visual Studio versions after 2022 (_MSC_VER > 1944) support the justification message.
-#define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
+#define GSL_SUPPRESS_USES_STRING_LITERAL 1
+#define GSL_SUPPRESS_IS_SUPPORTED 1
+#define GSL_SUPPRESS_IMPL(x) [[gsl::suppress(#x)]]
+#elif defined(_MSC_VER) && !defined(__INTEL_COMPILER) && !defined(__NVCC__) && (_MSC_VER >= 1950)
+#define GSL_SUPPRESS_USES_STRING_LITERAL 1
+#define GSL_SUPPRESS_IS_SUPPORTED 1
+#define GSL_SUPPRESS_IMPL(x) [[gsl::suppress(#x)]]
 #elif defined(_MSC_VER) && !defined(__INTEL_COMPILER) && !defined(__NVCC__)
-#define GSL_SUPPRESS(x) [[gsl::suppress(x)]]
+#define GSL_SUPPRESS_USES_STRING_LITERAL 0
+#define GSL_SUPPRESS_IS_SUPPORTED 1
+#define GSL_SUPPRESS_IMPL(x) [[gsl::suppress(x)]]
 #else
-#define GSL_SUPPRESS(x)
-#endif // defined(__clang__)
+#define GSL_SUPPRESS_USES_STRING_LITERAL 1
+#define GSL_SUPPRESS_IS_SUPPORTED 0
+#define GSL_SUPPRESS_IMPL(x)
+#endif
+
+#define GSL_SUPPRESS(x) GSL_SUPPRESS_IMPL(x)
 
 #if defined(__clang__) || defined(__GNUC__)
 #define GSL_LIKELY(x) __builtin_expect(!!(x), 1)
 #define GSL_UNLIKELY(x) __builtin_expect(!!(x), 0)
-
 #else
-
 #define GSL_LIKELY(x) (!!(x))
 #define GSL_UNLIKELY(x) (!!(x))
 #endif // defined(__clang__) || defined(__GNUC__)
