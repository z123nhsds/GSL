From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Trae AI <trae@example.com>
Date: Fri, 12 Jun 2026 00:00:00 +0000
Subject: [PATCH] fix GSL_SUPPRESS parsing and add regression test

Clang-style parsing of `gsl::suppress` expects the suppression tag in
string form. With the old macro, `GSL_SUPPRESS(type.1)` expanded to
`[[gsl::suppress(type.1)]]`, which leaves `type.1` as raw tokens rather
than a string literal and is rejected by stricter frontends.

After switching to `#x` on those compilers, whitespace inside the macro
argument becomes semantic: `GSL_SUPPRESS(type .1)` stringizes to
`"type .1"`, not `"type.1"`. That is why the tag must not contain a
space around `.`.

Before:
  #define GSL_SUPPRESS(x) [[gsl::suppress(x)]]

After:
  #if defined(__clang__) || defined(__GNUC__)
  #define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
  #elif defined(_MSC_VER)
  #define GSL_SUPPRESS(x) [[gsl::suppress(x)]]
  #else
  #define GSL_SUPPRESS(x)
  #endif

Minimal failing case before this change:

  #include <gsl/assert>
  GSL_SUPPRESS(type.1)
  void f();

---
 include/gsl/assert                  | 7 ++++++-
 tests/suppress_regression_tests.cpp | 13 +++++++++++++
 2 files changed, 19 insertions(+), 1 deletion(-)
 create mode 100644 tests/suppress_regression_tests.cpp

diff --git a/include/gsl/assert b/include/gsl/assert
index 1111111..2222222 100644
--- a/include/gsl/assert
+++ b/include/gsl/assert
@@ -41,7 +41,13 @@
 // make suppress attributes parse for some compilers
 // Hopefully temporary until suppression standardization occurs
 //
-#endif // defined(__clang__)
+#if defined(__clang__) || defined(__GNUC__)
+#define GSL_SUPPRESS(x) [[gsl::suppress(#x)]]
+#elif defined(_MSC_VER)
+#define GSL_SUPPRESS(x) [[gsl::suppress(x)]]
+#else
+#define GSL_SUPPRESS(x)
+#endif // defined(__clang__) || defined(__GNUC__)
 
 #if defined(__clang__) || defined(__GNUC__)
 #define GSL_LIKELY(x) __builtin_expect(!!(x), 1)
diff --git a/tests/suppress_regression_tests.cpp b/tests/suppress_regression_tests.cpp
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/tests/suppress_regression_tests.cpp
@@ -0,0 +1,13 @@
+#include <gsl/assert>
+
+#include <gtest/gtest.h>
+
+namespace
+{
+GSL_SUPPRESS(type.1)
+void suppress_regression_target() {}
+
+TEST(suppress_regression_tests, declaration_compiles)
+{
+    suppress_regression_target();
+    SUCCEED();
+}
+} // namespace
